{
    "name": "igcse-issue-worker",
    "main": "worker.js",
    "compatibility_date": "2025-10-05",
    "workers_dev": true,
    "routes": [
        { "pattern": "api.igcse-ide.com", "custom_domain": true }
    ],
    "r2_buckets": [
        {
            "bucket_name": "issue-uploads",
            "binding": "BUCKET"
        }
    ],
    "vars": {
        "GITHUB_OWNER": "aryansdomain",
        "GITHUB_REPO": "IGCSE-Pseudocode-IDE",
        "PUBLIC_BASE_URL": "https://api.igcse-ide.com",
        "MAX_UPLOAD_BYTES": "2097152", // 2 MB
        "ALLOWED_ORIGINS": "https://www.igcse-ide.com,https://igcse-ide.com,http://127.0.0.1:5500,http://127.0.0.1:5501",
        "ACCOUNT_ID": "6ac518c689dfb45243b4390ee6fcac8b",
        "BUCKET_NAME": "issue-uploads"
    }
}
